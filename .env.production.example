# Production example for AI Learning Server for Open edX v25.9.16.7.2.64.16.5.7.2.18
# Copy to .env.production and replace every CHANGE_ME value before running docker-compose.prod.yml.

APP_ENV=production
APP_VERSION=25.9.16.7.2.64.16.5.7.2.18
DEBUG=false
AUTO_CREATE_TABLES=false
# AI Server joins the Tutor/Open edX Docker network. Do not expose backend/frontend ports directly in production.
OPENEDX_SHARED_NETWORK=tutor_local_default
# BACKEND_PORT/FRONTEND_PORT are intentionally unused by docker-compose.prod.yml in Level 1 deployment.
# Operational script endpoints. These do not replace NEXT_PUBLIC_API_BASE_URL.
FRONTEND_URL=https://dash-cms.fpl.edu.vn
BACKEND_URL=https://dash-cms.fpl.edu.vn/api
NEXT_PUBLIC_API_BASE_URL=https://dash-cms.fpl.edu.vn
NEXT_PUBLIC_OPENEDX_CMS_BASE_URL=https://scms.fpl.edu.vn
# true: AI Server tự chuyển sang CMS bridge nếu chưa có phiên AI.
NEXT_PUBLIC_AUTO_CMS_SESSION_LOGIN=true
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_ENABLE_DIAGNOSTICS_UI=false
NEXT_PUBLIC_API_GET_TIMEOUT_MS=45000
NEXT_PUBLIC_API_WRITE_TIMEOUT_MS=120000

# docker-compose.prod.yml creates PostgreSQL with these values. DATABASE_URL must match them.
POSTGRES_DB=ai_openedx
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://ai_user:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/ai_openedx
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# v25.9.15.6.32 DB pool/timeout. Keep total possible connections below PostgreSQL max_connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=5000
BANK_DASHBOARD_CACHE_TTL_SECONDS=45
BANK_SEARCH_MAX_RESULTS=50
WEB_CONCURRENCY=2
WEB_TIMEOUT_SECONDS=120
FRONTEND_NPM_VERSION=10.9.2
FRONTEND_VALIDATE_IN_IMAGE=false
CELERY_CONCURRENCY=2
CELERY_HEAVY_CONCURRENCY=1
CELERY_ANALYTICS_CONCURRENCY=1
CELERY_TASK_ACKS_LATE=true
CELERY_TASK_REJECT_ON_WORKER_LOST=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=25
CELERY_WORKER_MAX_MEMORY_PER_CHILD_KB=600000
CELERY_RESULT_EXPIRES_SECONDS=86400
CELERY_BROKER_VISIBILITY_TIMEOUT_SECONDS=7200
CELERY_DEFAULT_SOFT_TIME_LIMIT_SECONDS=1500
CELERY_DEFAULT_TIME_LIMIT_SECONDS=1800
ACADEMIC_TEACHER_REPORT_SYNC_EXPORT_MAX_TEACHERS=20
ACADEMIC_TEACHER_REPORT_SYNC_EXPORT_MAX_STUDENTS=1000
ACADEMIC_TEACHER_REPORT_FILE_RETENTION_HOURS=48

# Batch 35 — Udemy production hardening
ACADEMIC_UDEMY_IMPORT_MAX_FILES=50
ACADEMIC_UDEMY_IMPORT_MAX_FILE_BYTES=20971520
ACADEMIC_UDEMY_IMPORT_MAX_TOTAL_BYTES=209715200
ACADEMIC_UDEMY_IMPORT_MAX_ROWS=300000
ACADEMIC_UDEMY_XLSX_MAX_ENTRIES=10000
ACADEMIC_UDEMY_XLSX_MAX_UNCOMPRESSED_BYTES=419430400
ACADEMIC_UDEMY_XLSX_MAX_COMPRESSION_RATIO=200
ACADEMIC_UDEMY_UPLOAD_RATE_LIMIT_PER_MINUTE=6
ACADEMIC_UDEMY_FILE_RETENTION_HOURS=72
ACADEMIC_UDEMY_EXPORT_FILE_RETENTION_HOURS=48
ACADEMIC_UDEMY_SYNC_EXPORT_MAX_ROWS=5000
ACADEMIC_UDEMY_WORKER_MAX_RETRIES=3
ACADEMIC_UDEMY_CLEANUP_INTERVAL_SECONDS=21600

# Explicit whitelist only. Do not use * in production.
CORS_ALLOWED_ORIGINS=https://dash-cms.fpl.edu.vn,https://cms.fpl.edu.vn,https://scms.fpl.edu.vn,https://app.cms.fpl.edu.vn

# /metrics is protected by X-Metrics-Token or Authorization: Bearer <token>.
METRICS_ENABLED=true
METRICS_TOKEN=CHANGE_ME_64_RANDOM_HEX_METRICS_TOKEN

# Model gateway
MODEL_PROVIDER=openai
OPENAI_MODEL=gpt-5-mini
OPENAI_API_MODE=responses
MOCK_LLM=false
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
LLM_TIMEOUT_SECONDS=90
OPENAI_PARALLEL_ENABLED=true
OPENAI_MAX_PARALLEL_CALLS=3
OPENAI_RETRY_MAX_ATTEMPTS=3
OPENAI_RETRY_BASE_SECONDS=2
OPENAI_PROMPT_CACHE_WARMUP_ENABLED=true
GENERATION_TAIL_BATCH_WAIT_ENABLED=true

# v25.9.14.6 Stable Family + native Ulmo ItemBank guided workflow
FAMILY_PLAN_RECONCILE_ON_PREVIEW=true
FAMILY_PLAN_REQUIRE_ALL_APPROVED=true
FAMILY_PLAN_HARD_DUPLICATE_GUARD=true

# Open edX connector - production must use the real connector.
USE_MOCK_OPENEDX=false
OPENEDX_BASE_URL=https://scms.fpl.edu.vn
OPENEDX_CMS_BASE_URL=https://scms.fpl.edu.vn
OPENEDX_CMS_INTERNAL_BASE_URL=http://cms.openedx.svc.cluster.local:8000
OPENEDX_CMS_HOST_HEADER=scms.fpl.edu.vn
OPENEDX_LIBRARY_ORG=FPT
OPENEDX_RETRY_MAX_ATTEMPTS=4
OPENEDX_RETRY_BASE_SECONDS=2
OPENEDX_RETRY_MAX_SECONDS=60
ACADEMIC_OPENEDX_ORG_BY_BRANCH=
ACADEMIC_DEFAULT_OPENEDX_COURSE_ORG=
OPENEDX_LMS_BASE_URL=https://cms.fpl.edu.vn
OPENEDX_OAUTH_BASE_URL=https://cms.fpl.edu.vn
OPENEDX_AUTHORING_MFE_BASE_URL=https://app.cms.fpl.edu.vn/authoring
# Backward-compatible alias for rolling upgrades. Prefer OPENEDX_AUTHORING_MFE_BASE_URL.
OPENEDX_MFE_BASE_URL=https://app.cms.fpl.edu.vn/authoring
OPENEDX_CLIENT_ID=CHANGE_ME_OPENEDX_OAUTH_CLIENT_ID
OPENEDX_CLIENT_SECRET=CHANGE_ME_OPENEDX_OAUTH_CLIENT_SECRET
OPENEDX_ACCESS_TOKEN=
OPENEDX_OAUTH_TOKEN_URL=/oauth2/access_token/
OPENEDX_COURSE_BLOCKS_PATH=/api/courses/v2/blocks/
OPENEDX_STUDIO_CONTENT_ENDPOINT=/api/ai-connector/v1/courses/{course_id}/studio-content
OPENEDX_PREFER_STUDIO_CONTENT=true
OPENEDX_PUBLISH_ENDPOINT=/api/ai-connector/v1/courses/{course_id}/problems
OPENEDX_LIBRARY_ENDPOINT=/api/ai-connector/v1/courses/{course_id}/libraries
OPENEDX_LIBRARY_IMPORT_ENDPOINT=/api/ai-connector/v1/libraries/{library_key}/problems
OPENEDX_LIBRARY_VERIFY_ENDPOINT=/api/ai-connector/v1/libraries/{library_key}/problems/verify
OPENEDX_LIBRARY_DELETE_ENDPOINT=/api/ai-connector/v1/libraries/{library_key}/problems/delete
OPENEDX_QUIZ_NODE_CREATE_ENDPOINT=/api/ai-connector/v1/courses/{course_id}/quiz-nodes
OPENEDX_PROBLEM_BANK_INSERT_ENDPOINT=/api/ai-connector/v1/courses/{course_id}/problem-banks
OPENEDX_REQUEST_TIMEOUT_SECONDS=30

# HMAC shared by AI Server backend and the CMS connector plugin.
# Generate one value and set it in both places, for example: openssl rand -hex 32
OPENEDX_CONNECTOR_HMAC_SECRET=CHANGE_ME_64_RANDOM_HEX_CONNECTOR_SECRET
OPENEDX_CONNECTOR_HMAC_SKEW_SECONDS=300
OPENEDX_ALLOWED_DOWNLOAD_HOSTS=scms.fpl.edu.vn,cms.fpl.edu.vn,app.cms.fpl.edu.vn
OPENEDX_ASSET_MAX_BYTES=15728640
OPENEDX_TRANSCRIPT_MAX_BYTES=2097152

# Auth/RBAC. Demo headers are disabled. Non-admin JWTs must contain course_ids/courses.
AUTH_MODE=openedx_sso
ALLOW_DEMO_ROLE_HEADER=false
# Optional: only needed if you want the guarded one-time /api/rbac/bootstrap/system-admin endpoint in production. Prefer CMS superuser/AI_ADMIN login for normal setup.
RBAC_BOOTSTRAP_TOKEN=
JWT_SECRET=CHANGE_ME_64_RANDOM_HEX_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_ISSUER=ai-learning-server
JWT_AUDIENCE=ai-learning-server-api
REQUIRE_COURSE_SCOPE_IN_PRODUCTION=true
# Production requires true. For an HTTP-only UAT deployment, use .env.uat-http.example instead.
AUTH_COOKIE_SECURE=true
ALLOW_INSECURE_UAT_HTTP=false
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_TOKEN_TTL_SECONDS=7200
# Optional. If empty, AI Server uses OPENEDX_CONNECTOR_HMAC_SECRET to verify CMS session bridge tickets.
OPENEDX_SESSION_BRIDGE_SECRET=

# Runtime config remains available for non-secret knobs only.
# Secrets above are environment-only and are not persisted to runtime-settings.json.
RUNTIME_CONFIG_PATH=/app/.runtime/runtime-settings.json
LOCAL_STORAGE_PATH=/app/.runtime
BANK_MATERIAL_EXTRACT_INLINE_ENABLED=false

# Persistent object storage: MinIO runs on a separate VM outside Kubernetes.
# Pre-create the private ai-server bucket and inject a bucket-scoped service
# account through the ai-server-minio Secret. Never commit real credentials.
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=https://s3.fpl.edu.vn
MINIO_BUCKET=ai-server
MINIO_ACCESS_KEY=CHANGE_ME_AI_SERVER_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_AI_SERVER_MINIO_SECRET_KEY
MINIO_SECURE=true
MINIO_REGION=
MINIO_CERT_CHECK=true
MINIO_AUTO_CREATE_BUCKET=false

# Cost governance
COST_INPUT_PRICE_PER_1M=0.25
COST_CACHED_INPUT_PRICE_PER_1M=0.025
COST_OUTPUT_PRICE_PER_1M=2.00
COST_SAFETY_FACTOR=1.5
USD_TO_VND=26342
DEFAULT_COURSE_QUESTION_QUOTA=200
DEFAULT_JOB_QUESTION_LIMIT=50
DEFAULT_RETRY_LIMIT=2
GLOBAL_MONTHLY_BUDGET_USD=100

TASK_ALWAYS_EAGER=false
GENERATION_BATCH_SIZE=50

# CMS connector plugin env vars. Put these in the CMS/Studio container too.
AI_CONNECTOR_PUBLISH_USERNAME=CHANGE_ME_STUDIO_STAFF_USERNAME
AI_CONNECTOR_ALLOW_ANONYMOUS_PUBLISH=false
AI_CONNECTOR_HMAC_SECRET=CHANGE_ME_64_RANDOM_HEX_CONNECTOR_SECRET
AI_CONNECTOR_HMAC_SKEW_SECONDS=300
AI_CONNECTOR_DEFAULT_ENROLLMENT_MODE=audit
AI_CONNECTOR_MAX_BATCH_SIZE=5000
# Default: auto-created CMS users have no local password; use SSO/password reset.
# UAT-only temporary password option: set mode=fixed and default password >= 8 chars in Tutor/Open edX.
AI_CONNECTOR_CREATED_USER_PASSWORD_MODE=unusable
AI_CONNECTOR_CREATED_USER_DEFAULT_PASSWORD=
AI_CONNECTOR_SESSION_BRIDGE_ALLOWED_RETURN_HOSTS=dash-cms.fpl.edu.vn
AI_CONNECTOR_DEBUG_ERRORS=false
AI_QUIZ_RUNTIME_ALLOWED_ORIGINS=https://app.cms.fpl.edu.vn,https://cms.fpl.edu.vn,https://scms.fpl.edu.vn
AI_CONNECTOR_ALLOWED_DOWNLOAD_HOSTS=scms.fpl.edu.vn,cms.fpl.edu.vn,app.cms.fpl.edu.vn
AI_CONNECTOR_AUTO_CREATE_ORG=false
AI_CONNECTOR_LIBRARY_ORG=FPT
AI_CONNECTOR_COMPONENT_PUBLISH_ENABLED=false
AI_CONNECTOR_TAGGING_ENABLED=true
AI_CONNECTOR_TAG_TAXONOMY_EXPORT_ID=ai-learning-check
AI_CONNECTOR_TAG_TAXONOMY_NAME=AI Learning Check

# Advanced extraction
FILE_OCR_ENABLED=false
FILE_OCR_LANGUAGE=vie+eng
FILE_OCR_MAX_PAGES=20
FILE_OCR_TESSERACT_CONFIG=--oem 3 --psm 6
PPTX_EXTRACT_SPEAKER_NOTES=true
PPTX_OCR_IMAGES_ENABLED=false
DOCX_OCR_IMAGES_ENABLED=true
DOCX_OCR_MAX_IMAGES=0
MATERIAL_UPLOAD_PREFLIGHT_ENABLED=true

# v25.9.15.0 Question Bank-first architecture
QUESTION_BANK_RELEASE_LIBRARY_POLICY=one_release_one_openedx_library
QUESTION_BANK_VERSIONING_ENABLED=true

# v25.9.15.6.37 async Bank operations and extraction safety
BANK_OPERATION_JOB_TTL_DAYS=30
MAX_UPLOAD_BYTES=52428800
MAX_PDF_PAGES=300
MAX_PPTX_SLIDES=300
MAX_DOCX_PARAGRAPHS=10000
MAX_DOCX_TABLES=500
MAX_XLSX_SHEETS=20
MAX_XLSX_ROWS_PER_SHEET=5000
MAX_CSV_ROWS=50000
MAX_ZIP_UNCOMPRESSED_BYTES=209715200
MAX_ZIP_MEMBERS=5000
MAX_EXTRACTED_CHARS=2000000

# v25.9.16 Academic AP sync credentials
ACADEMIC_AP_SYNC_ENABLED=true
ACADEMIC_AP_API_BASE_URL=https://api_v2.poly.edu.vn
# Danh sách môn: GET /get-course?branch=poly&term_name=<kỳ đã chọn>.
# Danh mục cơ sở không gọi AP; nhập và chỉnh sửa thủ công tại /premises.
ACADEMIC_AP_GET_COURSE_ENDPOINT=/get-course
ACADEMIC_AP_GET_COURSE_FILE_CACHE_ENABLED=true
ACADEMIC_AP_GET_COURSE_FILE_CACHE_DIR=/tmp/ai-server-ap-cache/get-course
ACADEMIC_AP_GET_COURSE_FILE_CACHE_TTL_SECONDS=86400
ACADEMIC_AP_GET_COURSE_FILE_CACHE_REFRESH=false
ACADEMIC_AP_TERM_BLOCK_REFRESH_TTL_SECONDS=3600
# Bắt buộc. Nạp từ Kubernetes Secret/Jenkins credential; không commit key thật.
# Backend gửi Authorization: Bearer cho cả /get-course và /get-data-cms.
ACADEMIC_AP_API_KEY=
ACADEMIC_AP_REQUEST_TIMEOUT_SECONDS=60
# api_v2.poly.edu.vn is an approved integration exception: TLS certificate verification is disabled for this host.
# ACADEMIC_AP_TLS_MODE remains available for any future AP host; use strict there whenever possible.
ACADEMIC_AP_TLS_MODE=off
# Docker extra_hosts entry for AP. Keep backend and worker identical when AP resolves to an internal IP.
ACADEMIC_AP_API_EXTRA_HOST=api_v2.poly.edu.vn:10.2.1.35
# Optional subject-code fallback only if AP get-course is temporarily unavailable.
ACADEMIC_AP_SUBJECT_CODES=

# v25.9.16.5.8 Student Management -> existing openedx_connector_plugin on LMS Django.
# Do not point this to the MFE app host. Use the LMS host: local.openedx.io / cms.fpl.edu.vn.
OPENEDX_CONNECTOR_BASE_URL=https://cms.fpl.edu.vn
OPENEDX_CONNECTOR_USERS_RESOLVE_ENDPOINT=/api/ai-connector/v1/users/resolve
OPENEDX_CONNECTOR_COURSE_SEARCH_ENDPOINT=/api/ai-connector/v1/courses/search
OPENEDX_CONNECTOR_CLASS_ANALYTICS_ENDPOINT=/api/ai-connector/v1/class-analytics
OPENEDX_CONNECTOR_ENROLLMENT_ENROLL_ENDPOINT=/api/ai-connector/v1/course-enrollment/enroll
OPENEDX_CONNECTOR_ENROLLMENT_REMOVE_ENDPOINT=/api/ai-connector/v1/course-enrollment/remove
OPENEDX_CONNECTOR_DEFAULT_ENROLLMENT_MODE=audit
# Legacy alias accepted by older Student Insight deployments.
OPENEDX_STUDENT_INSIGHT_DEFAULT_ENROLLMENT_MODE=audit
OPENEDX_CONNECTOR_CLIENT_ID=ai-server
OPENEDX_CONNECTOR_TIMEOUT_SECONDS=30
OPENEDX_CONNECTOR_MAX_BATCH_SIZE=100
ACADEMIC_AUTO_ENROLL_AFTER_CMS_SYNC=true
ACADEMIC_AUTO_CREATE_CMS_USERS=true
ACADEMIC_CLASS_SYNC_MAX_STUDENTS=5000
ACADEMIC_AUTO_ADD_TEACHERS_TO_COURSE=true
ACADEMIC_AUTO_MAP_COURSE_BEFORE_CMS_SYNC=true
ACADEMIC_FULL_SYNC_LEARNING_AFTER_ENROLLMENT=true
ACADEMIC_LEARNING_LOW_GRADE_THRESHOLD_PERCENT=50
ACADEMIC_LEARNING_LOW_PROGRESS_THRESHOLD_PERCENT=50
# Legacy aliases are still accepted during rolling upgrades, but new deployments should not set them.
# OPENEDX_STUDENT_INSIGHT_BASE_URL=
# OPENEDX_STUDENT_INSIGHT_SHARED_SECRET=
# OPENEDX_COURSES_SEARCH_ENDPOINT=/api/courses/v1/courses/

# v25.9.16.3.6 Bank material cleanup policy
BANK_MATERIAL_DELETED_RETENTION_DAYS=30
BANK_MATERIAL_CLEANUP_DEFAULT_LIMIT=500
BANK_MATERIAL_HARD_DELETE_UNUSED_ENABLED=true
BANK_MATERIAL_PURGE_DELETED_FILES_ENABLED=true

# AP sync DB growth guard
ACADEMIC_AP_SKIP_EMPTY_CLASSES=true
ACADEMIC_AP_IMPORT_CATALOG_SUBJECTS=false

# v25.9.16.6.3 Learning Behavior Analytics / Aspects-lite
# Host path should be: $(tutor config printroot)/data/lms/logs
OPENEDX_TRACKING_LOG_HOST_DIR=/home/thaitx3/.local/share/tutor/data/lms/logs
OPENEDX_TRACKING_LOG_PATH=/openedx-data/lms/logs/tracking.log
ANALYTICS_INGEST_ENABLED=true
ANALYTICS_INGEST_SCHEDULER_ENABLED=true
ANALYTICS_INGEST_INTERVAL_SECONDS=60
ANALYTICS_MAX_LINES_PER_RUN=50000
ANALYTICS_VIDEO_COMPLETE_THRESHOLD=0.9
ANALYTICS_SUSPICIOUS_WATCH_RATIO=0.25
ANALYTICS_MAX_PASSIVE_SEGMENT_SECONDS=600
ANALYTICS_ENABLE_PROBLEM_CORRELATION=true
ANALYTICS_SNAPSHOT_STALE_HOURS=168

# v25.9.16.6.9 Analytics production hardening
ANALYTICS_BACKFILL_MAX_JOBS_PER_REQUEST=25
ANALYTICS_BACKFILL_MAX_ACTIVE_JOBS=20
ANALYTICS_RECALCULATE_ENQUEUE_COOLDOWN_SECONDS=300
# v25.9.16.7.2.64.14 Post-ingest recalculate orchestrator: ingest may run every minute,
# but class recalculation is debounced and capped.
ANALYTICS_POST_INGEST_RECALCULATE_ENABLED=true
ANALYTICS_POST_INGEST_RECALCULATE_COOLDOWN_SECONDS=900
ANALYTICS_POST_INGEST_RECALCULATE_MAX_JOBS_PER_RUN=10
ANALYTICS_INGEST_ENQUEUE_COOLDOWN_SECONDS=120
ANALYTICS_EXPORT_MAX_ROWS=50000
ANALYTICS_PRODUCTION_MIN_EVENTS=1
ANALYTICS_PRODUCTION_MIN_SNAPSHOTS=1

# v25.9.16.7.2.4 Analytics pilot acceptance
ANALYTICS_PILOT_SAMPLE_LIMIT=5

# v25.9.16.7.2.4 Analytics rollout/monitoring controls
ANALYTICS_ROLLOUT_ENABLED=true
# off | pilot | production
ANALYTICS_ROLLOUT_MODE=production
# Empty allowlists mean all classes visible by RBAC. Use comma-separated values to pilot safely.
ANALYTICS_ROLLOUT_CAMPUSES=
ANALYTICS_ROLLOUT_BRANCHES=
ANALYTICS_ROLLOUT_CLASS_IDS=
ANALYTICS_ROLLOUT_COURSE_IDS=
ANALYTICS_ROLLOUT_ALLOW_BACKFILL=true
ANALYTICS_ROLLOUT_ALLOW_EXPORT=true
ANALYTICS_MONITORING_STALE_INGEST_SECONDS=900
ANALYTICS_MONITORING_STUCK_JOB_MINUTES=60
ANALYTICS_MONITORING_SNAPSHOT_STALE_HOURS=168
ANALYTICS_MONITORING_WARNING_ACTIVE_JOBS=10

# v25.9.16.7.2.64.14 Bank Quiz Final Test Production QA
ANALYTICS_SLA_INGEST_TARGET_SECONDS=300
ANALYTICS_SLA_SNAPSHOT_TARGET_SECONDS=3600
ANALYTICS_SLA_MAX_QUEUED_JOBS=50
ANALYTICS_SLA_MAX_FAILED_JOBS_LAST_HOUR=0
ANALYTICS_SLA_CLASS_GAP_LIMIT=20

# v25.9.16.7.2.64.14 UAT-only cleanup for wrong RollNumber identity mappings.
# For UAT only, set true temporarily; keep false in real production.
ACADEMIC_IDENTITY_CLEANUP_ALLOW_DESTRUCTIVE=false
ACADEMIC_IDENTITY_CLEANUP_CONFIRM_PHRASE=DELETE_WRONG_UAT_IDENTITY
OPENEDX_SESSION_BRIDGE_MAX_AGE_SECONDS=60
AUTH_EXCHANGE_RATE_LIMIT_PER_MINUTE=20
AUTH_EXCHANGE_TICKET_RATE_LIMIT_PER_MINUTE=3
