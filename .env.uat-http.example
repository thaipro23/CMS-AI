# AI Server UAT HTTP override fragment
#
# Apply these values on top of `.env.production.example` when a non-production
# UAT environment is intentionally served over plain HTTP. Do NOT use this
# override in production. Replace all CHANGE_ME values inherited from the base
# environment with real UAT secrets before deployment.
APP_ENV=uat
NEXT_PUBLIC_APP_ENV=uat
AUTH_COOKIE_SECURE=false
ALLOW_INSECURE_UAT_HTTP=true
